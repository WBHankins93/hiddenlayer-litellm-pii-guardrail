{
    "family": "hiddenlayer-litellm-task",
    "networkMode": "awsvpc",
    "requiresCompatibilities": ["FARGATE"],
    "cpu": "1024",
    "memory": "2048",
    "executionRoleArn": "arn:aws:iam::975050091758:role/ecsTaskExecutionRole",
    "taskRoleArn": "arn:aws:iam::975050091758:role/hiddenlayerLiteLLMTaskRole",
    "containerDefinitions": [
      {
        "name": "hiddenlayer-litellm",
        "image": "975050091758.dkr.ecr.us-east-1.amazonaws.com/hiddenlayer-litellm-pii-guardrail:latest",
        "essential": true,
        "portMappings": [
          {
            "containerPort": 4000,
            "protocol": "tcp"
          }
        ],
        "environment": [
          { "name": "PYTHONPATH", "value": "/app" },
          { "name": "PORT", "value": "4000" },
          { "name": "AWS_REGION_NAME", "value": "us-east-1" }
        ],
        "secrets": [
            {
              "name": "LITELLM_MASTER_KEY",
              "valueFrom": "arn:aws:secretsmanager:us-east-1:975050091758:secret:hiddenlayer-litellm/master-key-i7wVmf"
            },
            {
              "name": "GROQ_API_KEY",
              "valueFrom": "arn:aws:secretsmanager:us-east-1:975050091758:secret:hiddenlayer-litellm/groq-api-key-DHi0OY"
            }
          ],
        "logConfiguration": {
          "logDriver": "awslogs",
          "options": {
            "awslogs-group": "/ecs/hiddenlayer-litellm",
            "awslogs-region": "us-east-1",
            "awslogs-stream-prefix": "ecs"
          }
        }
      }
    ]
  }